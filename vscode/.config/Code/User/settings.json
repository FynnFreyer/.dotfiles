{
    // general
    "window.newWindowProfile": "Default",
    "chat.disableAIFeatures": true,
    "explorer.confirmDragAndDrop": false,
    // styling
    "window.autoDetectColorScheme": true,
    "workbench.colorTheme": "Light Modern",
    "workbench.preferredDarkColorTheme": "Dark Modern",
    "editor.fontFamily": "'Inconsolata Mono', monospace",
    "editor.fontLigatures": true,
    // ui elements
    "editor.scrollbar.horizontal": "hidden",
    "editor.showFoldingControls": "always",
    "editor.minimap.autohide": "scroll",
    "workbench.tree.renderIndentGuides": "always",
    "workbench.panel.defaultLocation": "bottom",
    "workbench.startupEditor": "none",
    // searching/finding
    "editor.find.autoFindInSelection": "multiline",
    "editor.selectionHighlightMultiline": true,
    "search.exclude": {
        "**/.ansible": true,
        "**/.venv": true,
        "**/venv": true
    },
    // file behaviour
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.autoSave": "afterDelay",
    // editing
    "editor.tabCompletion": "on",
    "editor.linkedEditing": true,
    "editor.unfoldOnClickAfterEndOfLine": true,
    "editor.mouseWheelZoom": true,
    "diffEditor.codeLens": true,
    "diffEditor.experimental.useTrueInlineView": true,
    // terminal
    "terminal.integrated.mouseWheelZoom": true,
    "terminal.integrated.allowChords": false,
    "terminal.integrated.allowedLinkSchemes": [
        "file",
        "http",
        "https",
        "mailto",
        "ftp"
    ],
    "terminal.integrated.altClickMovesCursor": false,
    "terminal.integrated.bellDuration": 500,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.lineHeight": 1,
    "terminal.integrated.persistentSessionScrollback": 1000,
    "terminal.integrated.scrollback": 5000,
    "terminal.integrated.suggest.inlineSuggestion": "off",
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.fontSize": 20,
    // browser
    "workbench.browser.dataStorage": "workspace",
    "workbench.browser.openLocalhostLinks": true,
    // git
    "git.autofetch": true,
    "git.blame.editorDecoration.enabled": true,
    // language overrides
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[snippets]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8"
    },
    "autopep8.args": [
        "--max-line-length",
        "120"
    ],
    "[shellscript]": {
        "editor.defaultFormatter": "mkhl.shfmt"
    },
}
